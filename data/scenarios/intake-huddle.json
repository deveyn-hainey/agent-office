{
  "id": "intake-huddle",
  "title": "Intake & planning huddle",
  "summary": "A request lands, the lead calls a huddle on 4F, the team plans, votes, and asks the human for a call.",
  "version": 1,
  "agents": ["lead", "codex", "musecode", "grok", "cursor", "chatgpt"],
  "chapters": [
    { "t": 0, "label": "Request lands" },
    { "t": 6, "label": "Huddle" },
    { "t": 20, "label": "Vote" },
    { "t": 30, "label": "Plan on the board" },
    { "t": 40, "label": "Your call" }
  ],
  "events": [
    { "t": 0,  "type": "status",  "agent": "lead", "state": "working", "task": "Triaging new request" },
    { "t": 0.5,"type": "feed",    "channel": "#pitchside", "who": "You", "text": "Can we add a dark-mode toggle to the odds screen? (KAN-142)" },
    { "t": 0.5,"type": "surface", "surface": "board-4f", "op": "push", "data": { "path": "requests", "item": { "who": "You", "text": "Dark-mode toggle on odds screen (KAN-142)" } } },
    { "t": 1.5,"type": "look",    "agents": ["lead", "chatgpt"], "at": "surface:board-4f" },
    { "t": 2.5,"type": "say",     "agent": "lead", "style": "think", "ms": 2500 },
    { "t": 5,  "type": "say",     "agent": "lead", "text": "New request from You. Huddle up." },
    { "t": 6,  "type": "move",    "agent": "lead",     "to": "slot:huddle-4f-1" },
    { "t": 6,  "type": "move",    "agent": "codex",    "to": "free:huddle-4f" },
    { "t": 6.3,"type": "move",    "agent": "musecode", "to": "free:huddle-4f" },
    { "t": 6.6,"type": "move",    "agent": "grok",     "to": "free:huddle-4f" },
    { "t": 6.9,"type": "move",    "agent": "cursor",   "to": "free:huddle-4f" },
    { "t": 7.2,"type": "move",    "agent": "chatgpt",  "to": "free:huddle-4f" },
    { "t": 7.5,"type": "waitArrive", "agents": ["lead", "codex", "musecode", "grok", "cursor", "chatgpt"], "timeout": 60 },
    { "t": 8,  "type": "say",     "agent": "codex",  "text": "I'll claim the theme tokens: src/theme/*.ts" },
    { "t": 11, "type": "say",     "agent": "cursor", "text": "UI seat for the toggle. Scope: src/ui/OddsScreen.tsx" },
    { "t": 14, "type": "say",     "agent": "grok",   "text": "Risk: contrast on the live-odds chips. I'll check on device." },
    { "t": 17, "type": "say",     "agent": "chatgpt","text": "Question: persist the choice per user or per device?" },
    { "t": 20, "type": "say",     "agent": "lead",   "text": "Proposal D-14: per device, default to system. Votes?" },
    { "t": 20.5,"type": "surface","surface": "vote-4f", "op": "push", "data": { "path": "proposals", "item": { "id": "D-14", "text": "Theme stored per device, default = system", "yes": 0, "no": 0, "locked": false } } },
    { "t": 22, "type": "vote",    "agent": "codex",    "proposal": "D-14", "choice": "yes" },
    { "t": 23, "type": "vote",    "agent": "musecode", "proposal": "D-14", "choice": "yes" },
    { "t": 25, "type": "say",     "agent": "lead",   "text": "Locked: D-14. Writing the plan." },
    { "t": 30, "type": "surface", "surface": "board-4f", "op": "merge", "data": { "steps": [ { "n": 1, "text": "Theme tokens (dark palette)" }, { "n": 2, "text": "Toggle component + storage" }, { "n": 3, "text": "Device contrast check" } ], "cards": [ { "id": "c1", "title": "Theme tokens", "owner": "codex", "scope": "src/theme/*", "key": "KAN-143" }, { "id": "c2", "title": "Toggle UI", "owner": "cursor", "scope": "src/ui/OddsScreen.tsx", "key": "KAN-144" }, { "id": "c3", "title": "Contrast QA", "owner": "grok", "scope": "device", "key": "KAN-145" } ] } },
    { "t": 34, "type": "release", "agents": ["codex", "musecode", "grok", "cursor", "chatgpt"] },
    { "t": 34, "type": "move",    "agent": "codex",  "to": "slot:desk-2f-ai-1" },
    { "t": 34, "type": "move",    "agent": "cursor", "to": "slot:desk-2f-ui-1" },
    { "t": 34, "type": "move",    "agent": "grok",   "to": "slot:desk-2f-mobile-1" },
    { "t": 36, "type": "waitArrive", "agents": ["codex", "cursor", "grok"], "timeout": 60 },
    { "t": 38, "type": "status",  "agent": "codex", "state": "working", "task": "Theme tokens (KAN-143)" },
    { "t": 40, "type": "ask",     "agent": "lead", "id": "ask-1", "text": "Your call: ship dark mode behind a flag first?", "options": ["Approve", "Skip"] },
    { "t": 41, "type": "toast",   "text": "Lead is waiting on you", "kind": "warn", "agent": "lead" }
  ]
}
